---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Professional cryptocurrency OHLCV data aggregation dashboard with real-time candlestick charts from 15 exchanges"
		/>
		<meta
			name="keywords"
			content="crypto, OHLCV, candlestick, trading, aggregator, bitcoin, ethereum"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Google Fonts — Space Grotesk + IBM Plex Sans/Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<!-- TradingView Lightweight Charts -->
		<script
			src="https://unpkg.com/lightweight-charts@4.2.2/dist/lightweight-charts.standalone.production.js"
		></script>

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* ===== Reset ===== */
	*,
	*::before,
	*::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	/* ===== Design Tokens ===== */
	:root {
		/* Palette — Raw dark with single amber accent */
		--bg-0: #0a0a0a;
		--bg-1: #111111;
		--bg-2: #181818;
		--bg-3: #1f1f1f;
		--bg-hover: #242424;

		--border-0: #1e1e1e;
		--border-1: #2a2a2a;
		--border-2: #333333;
		--border-active: #FF6B00;

		--text-0: #e8e6e3;
		--text-1: #a0a0a0;
		--text-2: #5c5c5c;

		--accent: #FF6B00;
		--accent-dim: rgba(255, 107, 0, 0.12);
		--accent-hover: #FF8533;

		--green: #00D672;
		--red: #FF3B30;
		--green-dim: rgba(0, 214, 114, 0.1);
		--red-dim: rgba(255, 59, 48, 0.1);

		/* Typography */
		--font-heading: "Space Grotesk", system-ui, sans-serif;
		--font-body: "IBM Plex Sans", system-ui, sans-serif;
		--font-mono: "IBM Plex Mono", "Consolas", monospace;

		--text-xs: 0.6875rem;   /* 11px */
		--text-sm: 0.75rem;     /* 12px */
		--text-base: 0.8125rem; /* 13px */
		--text-md: 0.9375rem;   /* 15px */
		--text-lg: 1.125rem;    /* 18px */
		--text-xl: 1.5rem;      /* 24px */
		--text-2xl: 2rem;       /* 32px */

		/* Spacing */
		--sp-1: 4px;
		--sp-2: 8px;
		--sp-3: 12px;
		--sp-4: 16px;
		--sp-5: 20px;
		--sp-6: 24px;
		--sp-8: 32px;

		/* Radius — sharp, max 4px */
		--radius-sm: 2px;
		--radius-md: 3px;
		--radius-lg: 4px;

		/* Layout */
		--sidebar-w: 280px;
		--header-h: 48px;

		/* Transitions */
		--ease: 120ms ease;
		--ease-slow: 200ms ease;
	}

	/* ===== Base ===== */
	html {
		font-size: 16px;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		font-family: var(--font-body);
		background: var(--bg-0);
		color: var(--text-0);
		line-height: 1.5;
		min-height: 100vh;
	}

	/* ===== Scrollbar ===== */
	::-webkit-scrollbar { width: 4px; height: 4px; }
	::-webkit-scrollbar-track { background: transparent; }
	::-webkit-scrollbar-thumb { background: var(--border-1); }
	::-webkit-scrollbar-thumb:hover { background: var(--border-2); }

	/* ===== Forms ===== */
	input,
	select,
	textarea {
		font-family: var(--font-body);
		font-size: var(--text-base);
		color: var(--text-0);
		background: var(--bg-2);
		border: 1px solid var(--border-1);
		border-radius: var(--radius-md);
		padding: var(--sp-2) var(--sp-3);
		outline: none;
		transition: border-color var(--ease);
		width: 100%;
	}

	input:hover { border-color: var(--border-2); }

	input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	input::placeholder { color: var(--text-2); }

	/* ===== Buttons ===== */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: var(--sp-2) var(--sp-4);
		border-radius: var(--radius-md);
		border: 1px solid transparent;
		cursor: pointer;
		transition: all var(--ease);
		white-space: nowrap;
		user-select: none;
	}

	.btn:active { transform: scale(0.98); }

	.btn-primary {
		background: var(--accent);
		color: #000;
		border-color: var(--accent);
	}

	.btn-primary:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.btn-primary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.btn-primary:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.btn-ghost {
		background: transparent;
		color: var(--text-1);
		border: 1px solid var(--border-1);
	}

	.btn-ghost:hover {
		background: var(--bg-3);
		color: var(--text-0);
		border-color: var(--border-2);
	}

	.btn-ghost:focus-visible {
		border-color: var(--accent);
	}

	.btn-ghost.active {
		background: var(--accent-dim);
		color: var(--accent);
		border-color: var(--accent);
	}

	.btn-sm {
		font-size: var(--text-xs);
		padding: 3px var(--sp-2);
	}

	/* ===== Labels ===== */
	.label {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--text-2);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--sp-2);
	}

	/* ===== Badge ===== */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		padding: 1px 6px;
		border-radius: var(--radius-sm);
	}

	.badge-success {
		background: var(--green-dim);
		color: var(--green);
	}

	.badge-danger {
		background: var(--red-dim);
		color: var(--red);
	}

	/* ===== Divider ===== */
	.divider {
		height: 1px;
		background: var(--border-0);
		margin: var(--sp-4) 0;
	}

	/* ===== Toast ===== */
	.toast-container {
		position: fixed;
		bottom: var(--sp-4);
		right: var(--sp-4);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.toast {
		padding: var(--sp-2) var(--sp-3);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.03em;
		background: var(--bg-1);
		border: 1px solid var(--border-1);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
		display: flex;
		align-items: center;
		gap: var(--sp-2);
		max-width: 420px;
		animation: toastIn 0.15s ease-out;
	}

	.toast-tag {
		font-weight: 700;
		flex-shrink: 0;
	}

	.toast-error {
		border-left: 3px solid var(--red);
		color: var(--text-0);
	}
	.toast-error .toast-tag {
		color: var(--red);
	}

	.toast-success {
		border-left: 3px solid var(--green);
		color: var(--text-0);
	}
	.toast-success .toast-tag {
		color: var(--green);
	}

	.toast-info {
		border-left: 3px solid var(--accent);
		color: var(--text-0);
	}
	.toast-info .toast-tag {
		color: var(--accent);
	}

	/* ===== Animations — minimal, functional ===== */
	@keyframes toastIn {
		from { opacity: 0; transform: translateX(8px); }
		to { opacity: 1; transform: translateX(0); }
	}

	@keyframes spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.hidden { display: none !important; }
</style>
