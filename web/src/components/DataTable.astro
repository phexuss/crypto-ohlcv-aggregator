---
---

<div class="data-table-wrapper hidden" id="data-table-wrapper">
	<button class="table-toggle" id="table-toggle">
		<span class="toggle-icon">[+]</span>
		<span class="toggle-title">DATA TABLE</span>
		<span class="table-count" id="table-count"></span>
	</button>

	<div class="table-container hidden" id="table-container">
		<div class="table-scroll">
			<table class="data-table" id="data-table">
				<thead id="table-head"></thead>
				<tbody id="table-body"></tbody>
			</table>
		</div>
	</div>
</div>

<style>
	.data-table-wrapper {
		margin-top: var(--sp-4);
	}

	.table-toggle {
		display: flex;
		align-items: center;
		gap: var(--sp-2);
		width: 100%;
		padding: var(--sp-2) var(--sp-3);
		background: var(--bg-1);
		border: 1px solid var(--border-0);
		border-radius: var(--radius-sm);
		color: var(--text-1);
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: all var(--ease);
	}

	.table-toggle:hover {
		background: var(--bg-2);
		border-color: var(--border-1);
		color: var(--text-0);
	}

	.toggle-icon {
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.table-toggle.expanded .toggle-icon {
		color: var(--text-2);
	}

	.table-count {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-2);
		margin-left: auto;
	}

	.table-container {
		margin-top: var(--sp-2);
		border: 1px solid var(--border-0);
		border-radius: var(--radius-sm);
		background: var(--bg-0);
		overflow: hidden;
	}

	.table-scroll {
		overflow-x: auto;
		max-height: 380px;
		overflow-y: auto;
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
	}

	.data-table :global(th) {
		position: sticky;
		top: 0;
		background: var(--bg-2);
		padding: var(--sp-2) var(--sp-3);
		text-align: left;
		font-family: var(--font-heading);
		font-size: 10px;
		font-weight: 700;
		color: var(--text-2);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		border-bottom: 1px solid var(--border-1);
		white-space: nowrap;
		cursor: pointer;
		user-select: none;
		transition: color var(--ease);
		z-index: 1;
	}

	.data-table :global(th:hover) {
		color: var(--text-0);
	}

	.data-table :global(th.sorted) {
		color: var(--accent);
	}

	.data-table :global(td) {
		padding: 6px var(--sp-3);
		border-bottom: 1px solid var(--border-0);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-0);
		white-space: nowrap;
	}

	.data-table :global(tr:hover td) {
		background: var(--bg-2);
	}

	.data-table :global(.cell-timestamp) {
		color: var(--text-2);
	}

	.data-table :global(.cell-green) {
		color: var(--green);
	}

	.data-table :global(.cell-red) {
		color: var(--red);
	}

	.data-table :global(.cell-best) {
		background: var(--green-dim);
	}

	.data-table :global(.cell-worst) {
		background: var(--red-dim);
	}
</style>

<script>
	const toggle = document.getElementById("table-toggle");
	const container = document.getElementById("table-container");
	const icon = toggle?.querySelector(".toggle-icon");

	if (toggle && container) {
		toggle.addEventListener("click", () => {
			const expanded = toggle.classList.toggle("expanded");
			container.classList.toggle("hidden");
			if (icon) icon.textContent = expanded ? "[-]" : "[+]";
		});
	}
</script>
