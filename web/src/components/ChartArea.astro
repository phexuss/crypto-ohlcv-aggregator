---
---

<div class="chart-area" id="chart-area">
	<!-- Toolbar -->
	<div class="chart-toolbar">
		<div class="toolbar-left">
			<h2 class="chart-title" id="chart-title">MARKET OVERVIEW</h2>
			<span class="chart-subtitle" id="chart-subtitle">READY</span>
		</div>
		<div class="toolbar-right">
			<div class="view-mode-toggle" id="view-mode-toggle">
				<button class="toggle-btn active" data-mode="grid" title="Grid View">
					GRID
				</button>
				<button class="toggle-btn" data-mode="overlay" title="Overlay View">
					OVERLAY
				</button>
			</div>
		</div>
	</div>

	<!-- Chart Container -->
	<div class="chart-container" id="chart-container">
		<!-- Empty State -->
		<div class="empty-state" id="empty-state">
			<div class="empty-terminal-prompt">
				<span class="prompt-symbol">&gt;</span>
				<span class="prompt-text">NO DATA LOADED. SELECT EXCHANGES &amp; CLICK FETCH.</span>
			</div>
		</div>

		<!-- Loading State -->
		<div class="loading-state hidden" id="loading-state">
			<div class="loading-indicator">[ FETCHING MARKET DATA ]</div>
			<p class="loading-sub" id="loading-sub"></p>
		</div>

		<!-- Charts rendered by chart.ts -->
		<div class="charts-grid hidden" id="charts-grid"></div>
		<div class="chart-overlay hidden" id="chart-overlay"></div>
	</div>
</div>

<style>
	.chart-area {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--bg-1);
		border: 1px solid var(--border-0);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.chart-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--sp-3) var(--sp-4);
		border-bottom: 1px solid var(--border-0);
		background: var(--bg-2);
		flex-shrink: 0;
	}

	.toolbar-left {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
	}

	.chart-title {
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 700;
		color: var(--text-0);
		letter-spacing: 0.05em;
	}

	.chart-subtitle {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-2);
	}

	.toolbar-right {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
	}

	.view-mode-toggle {
		display: flex;
		gap: 2px;
		background: var(--bg-0);
		padding: 2px;
		border: 1px solid var(--border-1);
		border-radius: var(--radius-sm);
	}

	.view-mode-toggle .toggle-btn {
		padding: 3px var(--sp-3);
		border-radius: var(--radius-sm);
		border: none;
		background: transparent;
		color: var(--text-2);
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: all var(--ease);
	}

	.view-mode-toggle .toggle-btn:hover {
		color: var(--text-0);
	}

	.view-mode-toggle .toggle-btn.active {
		background: var(--accent);
		color: #000;
	}

	/* Chart Container */
	.chart-container {
		flex: 1;
		min-height: 420px;
		position: relative;
		background: var(--bg-0);
	}

	/* Empty State */
	.empty-state {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		min-height: 420px;
		padding: var(--sp-6);
	}

	.empty-terminal-prompt {
		display: flex;
		align-items: center;
		gap: var(--sp-2);
		padding: var(--sp-3) var(--sp-5);
		background: var(--bg-1);
		border: 1px solid var(--border-1);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.prompt-symbol {
		color: var(--accent);
		font-weight: 700;
	}

	.prompt-text {
		color: var(--text-1);
		letter-spacing: 0.05em;
	}

	/* Loading State */
	.loading-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		min-height: 420px;
		gap: var(--sp-2);
	}

	.loading-indicator {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent);
		letter-spacing: 0.1em;
		animation: pulse 1s infinite alternate;
	}

	@keyframes pulse {
		from { opacity: 0.4; }
		to { opacity: 1; }
	}

	.loading-sub {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-2);
	}

	/* Charts Grid (grid mode) */
	.charts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1px;
		background: var(--border-0);
		padding: 1px;
		height: 100%;
		min-height: 420px;
		overflow-y: auto;
	}

	.charts-grid :global(.chart-card) {
		background: var(--bg-1);
		min-height: 300px;
		display: flex;
		flex-direction: column;
	}

	.charts-grid :global(.chart-card-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--sp-2) var(--sp-3);
		background: var(--bg-2);
		border-bottom: 1px solid var(--border-0);
	}

	.charts-grid :global(.chart-card-name) {
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--text-0);
	}

	.charts-grid :global(.chart-card-price) {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
	}

	.charts-grid :global(.chart-card-body) {
		flex: 1;
		min-height: 250px;
	}

	/* Chart Overlay (overlay mode) */
	.chart-overlay {
		height: 100%;
		min-height: 420px;
		padding: var(--sp-3);
		display: flex;
		flex-direction: column;
	}

	.chart-overlay :global(.overlay-legend) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-4);
		padding: var(--sp-2) var(--sp-3);
		background: var(--bg-1);
		border: 1px solid var(--border-0);
		margin-bottom: var(--sp-2);
	}

	.chart-overlay :global(.legend-item) {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-1);
	}

	.chart-overlay :global(.legend-dot) {
		width: 6px;
		height: 6px;
		border-radius: 1px;
	}

	.chart-overlay :global(.overlay-chart-wrapper) {
		flex: 1;
		min-height: 360px;
	}

	@media (max-width: 768px) {
		.charts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// View mode toggle
	const viewModeToggle = document.getElementById("view-mode-toggle");
	if (viewModeToggle) {
		viewModeToggle.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				viewModeToggle.querySelectorAll(".toggle-btn").forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");

				const mode = btn.dataset.mode;
				const event = new CustomEvent("viewModeChange", { detail: { mode } });
				window.dispatchEvent(event);
			});
		});
	}
</script>
