---
---

<header class="header">
	<div class="header-left">
		<div class="logo">
			<div class="logo-mark">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
					<rect x="2" y="7" width="4" height="10" fill="#FF6B00" />
					<rect x="8" y="3" width="4" height="18" fill="#FF6B00" opacity="0.7" />
					<rect x="14" y="9" width="4" height="6" fill="#FF6B00" opacity="0.5" />
					<rect x="20" y="5" width="2" height="14" fill="#FF6B00" opacity="0.3" />
					<line x1="4" y1="5" x2="4" y2="9" stroke="#FF6B00" stroke-width="1.5" />
					<line x1="10" y1="1" x2="10" y2="5" stroke="#FF6B00" stroke-width="1.5" opacity="0.7" />
					<line x1="16" y1="7" x2="16" y2="11" stroke="#FF6B00" stroke-width="1.5" opacity="0.5" />
					<line x1="4" y1="15" x2="4" y2="19" stroke="#FF6B00" stroke-width="1.5" />
					<line x1="10" y1="19" x2="10" y2="23" stroke="#FF6B00" stroke-width="1.5" opacity="0.7" />
					<line x1="16" y1="13" x2="16" y2="17" stroke="#FF6B00" stroke-width="1.5" opacity="0.5" />
				</svg>
			</div>
			<span class="logo-name">OHLCV</span>
			<span class="logo-sep">/</span>
			<span class="logo-sub">Aggregator</span>
		</div>
	</div>

	<div class="header-right">
		<div class="health" id="health-indicator">
			<span class="health-dot"></span>
			<span class="health-label">—</span>
		</div>
		<a href="/swagger" target="_blank" rel="noopener" class="header-link">
			Docs ↗
		</a>
	</div>
</header>

<style>
	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: var(--header-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 var(--sp-5);
		background: var(--bg-1);
		border-bottom: 1px solid var(--border-0);
		z-index: 100;
	}

	.header-left {
		display: flex;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: var(--sp-2);
	}

	.logo-mark {
		display: flex;
		align-items: center;
		margin-right: 2px;
	}

	.logo-name {
		font-family: var(--font-heading);
		font-size: var(--text-md);
		font-weight: 700;
		color: var(--text-0);
		letter-spacing: -0.02em;
	}

	.logo-sep {
		color: var(--text-2);
		font-weight: 300;
	}

	.logo-sub {
		font-family: var(--font-heading);
		font-size: var(--text-md);
		font-weight: 400;
		color: var(--text-1);
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: var(--sp-5);
	}

	.health {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-2);
	}

	.health-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--text-2);
		transition: background var(--ease-slow);
	}

	.health.online .health-dot { background: var(--green); }
	.health.online .health-label { color: var(--green); }
	.health.offline .health-dot { background: var(--red); }
	.health.offline .health-label { color: var(--red); }

	.header-link {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-2);
		text-decoration: none;
		padding: 3px 8px;
		border: 1px solid var(--border-1);
		border-radius: var(--radius-sm);
		transition: all var(--ease);
	}

	.header-link:hover {
		color: var(--text-0);
		border-color: var(--border-2);
		background: var(--bg-3);
	}

	.header-link:focus-visible {
		border-color: var(--accent);
		outline: none;
	}
</style>

<script>
	async function checkHealth() {
		const el = document.getElementById("health-indicator");
		const label = el?.querySelector(".health-label");
		if (!el || !label) return;

		try {
			const res = await fetch("/api/health");
			if (res.ok) {
				el.className = "health online";
				label.textContent = "ONLINE";
			} else { throw 0; }
		} catch {
			el.className = "health offline";
			label.textContent = "OFFLINE";
		}
	}

	checkHealth();
	setInterval(checkHealth, 30000);
</script>
