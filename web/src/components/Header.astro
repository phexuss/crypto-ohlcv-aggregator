---
---

<header class="header glass">
	<div class="header-left">
		<div class="logo">
			<div class="logo-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<rect x="2" y="6" width="4" height="12" rx="1" fill="url(#grad1)" />
					<rect x="8" y="3" width="4" height="18" rx="1" fill="url(#grad2)" />
					<rect x="14" y="8" width="4" height="8" rx="1" fill="url(#grad3)" />
					<rect x="20" y="5" width="2" height="14" rx="1" fill="url(#grad4)" />
					<line x1="4" y1="4" x2="4" y2="8" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round" />
					<line x1="10" y1="1" x2="10" y2="5" stroke="#818cf8" stroke-width="1.5" stroke-linecap="round" />
					<line x1="16" y1="6" x2="16" y2="10" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" />
					<line x1="4" y1="16" x2="4" y2="20" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round" />
					<line x1="10" y1="19" x2="10" y2="23" stroke="#818cf8" stroke-width="1.5" stroke-linecap="round" />
					<line x1="16" y1="14" x2="16" y2="18" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" />
					<defs>
						<linearGradient id="grad1" x1="4" y1="6" x2="4" y2="18" gradientUnits="userSpaceOnUse">
							<stop stop-color="#a78bfa" />
							<stop offset="1" stop-color="#8b5cf6" />
						</linearGradient>
						<linearGradient id="grad2" x1="10" y1="3" x2="10" y2="21" gradientUnits="userSpaceOnUse">
							<stop stop-color="#818cf8" />
							<stop offset="1" stop-color="#6366f1" />
						</linearGradient>
						<linearGradient id="grad3" x1="16" y1="8" x2="16" y2="16" gradientUnits="userSpaceOnUse">
							<stop stop-color="#6366f1" />
							<stop offset="1" stop-color="#4f46e5" />
						</linearGradient>
						<linearGradient id="grad4" x1="21" y1="5" x2="21" y2="19" gradientUnits="userSpaceOnUse">
							<stop stop-color="#4f46e5" />
							<stop offset="1" stop-color="#3b82f6" />
						</linearGradient>
					</defs>
				</svg>
			</div>
			<div class="logo-text">
				<span class="logo-name">OHLCV Aggregator</span>
				<span class="logo-version">v1.0.50</span>
			</div>
		</div>
	</div>

	<div class="header-right">
		<div class="health-indicator" id="health-indicator">
			<span class="health-dot"></span>
			<span class="health-text">Checking...</span>
		</div>
		<a
			href="/swagger"
			target="_blank"
			rel="noopener"
			class="btn btn-ghost btn-sm"
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
				<polyline points="14 2 14 8 20 8"></polyline>
				<line x1="16" y1="13" x2="8" y2="13"></line>
				<line x1="16" y1="17" x2="8" y2="17"></line>
				<polyline points="10 9 9 9 8 9"></polyline>
			</svg>
			API Docs
		</a>
	</div>
</header>

<style>
	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: var(--header-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 var(--space-6);
		z-index: 100;
		border-bottom: 1px solid var(--border-subtle);
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.logo-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-md);
		background: rgba(139, 92, 246, 0.1);
		border: 1px solid rgba(139, 92, 246, 0.2);
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}

	.logo-name {
		font-size: var(--text-md);
		font-weight: 700;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.logo-version {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.health-indicator {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-xs);
		color: var(--text-muted);
	}

	.health-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--text-muted);
		transition: background var(--transition-base), box-shadow var(--transition-base);
	}

	.health-indicator.online .health-dot {
		background: var(--color-green);
		box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
	}

	.health-indicator.online .health-text {
		color: var(--color-green);
	}

	.health-indicator.offline .health-dot {
		background: var(--color-red);
		box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
	}

	.health-indicator.offline .health-text {
		color: var(--color-red);
	}

	@media (max-width: 640px) {
		.logo-version {
			display: none;
		}
	}
</style>

<script>
	async function checkHealth() {
		const indicator = document.getElementById("health-indicator");
		const textEl = indicator?.querySelector(".health-text");
		if (!indicator || !textEl) return;

		try {
			const res = await fetch("/api/health");
			if (res.ok) {
				indicator.className = "health-indicator online";
				textEl.textContent = "API Online";
			} else {
				throw new Error("Not ok");
			}
		} catch {
			indicator.className = "health-indicator offline";
			textEl.textContent = "API Offline";
		}
	}

	checkHealth();
	setInterval(checkHealth, 30000);
</script>
