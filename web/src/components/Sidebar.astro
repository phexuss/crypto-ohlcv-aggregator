---
const exchanges = [
	{ id: "binance", name: "Binance", tier: 1 },
	{ id: "okx", name: "OKX", tier: 1 },
	{ id: "bybit", name: "Bybit", tier: 1 },
	{ id: "kucoin", name: "KuCoin", tier: 2 },
	{ id: "bitget", name: "Bitget", tier: 2 },
	{ id: "mexc", name: "MEXC", tier: 2 },
	{ id: "gateio", name: "Gate.io", tier: 2 },
	{ id: "bitmex", name: "BitMEX", tier: 3 },
	{ id: "htx", name: "HTX", tier: 3 },
	{ id: "hyperliquid", name: "HyperLiquid", tier: 3 },
	{ id: "xt", name: "XT", tier: 3 },
	{ id: "bingx", name: "BingX", tier: 3 },
	{ id: "coinex", name: "CoinEx", tier: 3 },
	{ id: "bitmart", name: "Bitmart", tier: 3 },
	{ id: "blofin", name: "Blofin", tier: 3 },
];

const intervals = ["1m", "5m", "15m", "1h", "4h", "1d"];
const periods = [
	{ label: "24h", value: "24h" },
	{ label: "7d", value: "7d" },
	{ label: "30d", value: "30d" },
];
---

<aside class="sidebar" id="sidebar">
	<div class="sidebar-inner">
		<!-- Exchange Selector -->
		<section class="sidebar-section">
			<div class="section-header">
				<span class="label">Exchanges</span>
				<div class="quick-select">
					<button class="btn btn-ghost btn-sm" data-select="all">All</button>
					<button class="btn btn-ghost btn-sm" data-select="tier1">T1</button>
					<button class="btn btn-ghost btn-sm" data-select="none">Clear</button>
				</div>
			</div>
			<div class="exchange-grid" id="exchange-grid">
				{exchanges.map((ex) => (
					<label class="exchange-item" data-exchange={ex.id} data-tier={ex.tier}>
						<input type="checkbox" name="exchange" value={ex.id} />
						<span class="item-box">
							<span class="tier-indicator" data-tier={ex.tier}></span>
							<span class="ex-name">{ex.name}</span>
						</span>
					</label>
				))}
			</div>
		</section>

		<div class="divider"></div>

		<!-- Market Input -->
		<section class="sidebar-section">
			<label class="label" for="market-input">Market Symbol</label>
			<input
				type="text"
				id="market-input"
				placeholder="BTCUSDT"
				value="BTCUSDT"
				spellcheck="false"
				autocomplete="off"
			/>
		</section>

		<div class="divider"></div>

		<!-- Interval Selector -->
		<section class="sidebar-section">
			<span class="label">Timeframe</span>
			<div class="grid-buttons" id="interval-group">
				{intervals.map((int) => (
					<button
						class={`toggle-btn ${int === "1h" ? "active" : ""}`}
						data-interval={int}
					>
						{int}
					</button>
				))}
			</div>
		</section>

		<div class="divider"></div>

		<!-- Period Selector -->
		<section class="sidebar-section">
			<span class="label">Period Range</span>
			<div class="grid-buttons" id="period-group">
				{periods.map((p) => (
					<button
						class={`toggle-btn ${p.value === "24h" ? "active" : ""}`}
						data-period={p.value}
					>
						{p.label}
					</button>
				))}
				<button class="toggle-btn" data-period="custom" id="custom-period-btn">
					Custom
				</button>
			</div>
			<input
				type="text"
				id="custom-period-input"
				class="custom-period-input hidden"
				placeholder="e.g. 12h, 3d, or timestamp"
				spellcheck="false"
			/>
		</section>

		<div class="divider"></div>

		<!-- Fetch Button -->
		<button class="btn btn-primary fetch-btn" id="fetch-btn">
			<span class="fetch-text">FETCH MARKET DATA</span>
		</button>

		<!-- Stats Panel -->
		<div class="stats-panel hidden" id="stats-panel">
			<div class="divider"></div>
			<span class="label">Session Stats</span>
			<div class="stats-list">
				<div class="stat-row">
					<span class="stat-key">EXCHANGES</span>
					<span class="stat-val" id="stat-exchanges">—</span>
				</div>
				<div class="stat-row">
					<span class="stat-key">DATA POINTS</span>
					<span class="stat-val" id="stat-datapoints">—</span>
				</div>
				<div class="stat-row">
					<span class="stat-key">RANGE</span>
					<span class="stat-val" id="stat-timerange">—</span>
				</div>
			</div>
		</div>
	</div>
</aside>

<style>
	.sidebar {
		position: fixed;
		top: var(--header-h);
		left: 0;
		bottom: 0;
		width: var(--sidebar-w);
		background: var(--bg-1);
		border-right: 1px solid var(--border-0);
		overflow-y: auto;
		z-index: 50;
	}

	.sidebar-inner {
		padding: var(--sp-4);
		display: flex;
		flex-direction: column;
	}

	.sidebar-section {
		display: flex;
		flex-direction: column;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--sp-2);
	}

	.section-header .label {
		margin-bottom: 0;
	}

	.quick-select {
		display: flex;
		gap: 4px;
	}

	/* Exchange Grid — Sharp, compact rectangular checkboxes */
	.exchange-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 4px;
	}

	.exchange-item {
		cursor: pointer;
		user-select: none;
	}

	.exchange-item input {
		display: none;
	}

	.item-box {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 5px 8px;
		background: var(--bg-2);
		border: 1px solid var(--border-1);
		border-radius: var(--radius-sm);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		color: var(--text-1);
		transition: all var(--ease);
	}

	.tier-indicator {
		width: 4px;
		height: 4px;
		flex-shrink: 0;
	}

	.tier-indicator[data-tier="1"] { background: var(--green); }
	.tier-indicator[data-tier="2"] { background: var(--accent); }
	.tier-indicator[data-tier="3"] { background: var(--text-2); }

	.ex-name {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.exchange-item:hover .item-box {
		background: var(--bg-3);
		border-color: var(--border-2);
		color: var(--text-0);
	}

	.exchange-item input:checked + .item-box {
		background: var(--accent-dim);
		border-color: var(--accent);
		color: var(--accent);
		font-weight: 500;
	}

	/* Grid Buttons for Interval & Period */
	.grid-buttons {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 4px;
	}

	.toggle-btn {
		padding: 6px var(--sp-2);
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-1);
		background: var(--bg-2);
		color: var(--text-1);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		cursor: pointer;
		text-align: center;
		transition: all var(--ease);
	}

	.toggle-btn:hover {
		background: var(--bg-3);
		border-color: var(--border-2);
		color: var(--text-0);
	}

	.toggle-btn:focus-visible {
		border-color: var(--accent);
		outline: none;
	}

	.toggle-btn.active {
		background: var(--accent-dim);
		border-color: var(--accent);
		color: var(--accent);
	}

	.custom-period-input {
		margin-top: var(--sp-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	/* Fetch Button */
	.fetch-btn {
		width: 100%;
		padding: var(--sp-3);
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		letter-spacing: 0.05em;
		margin-top: var(--sp-2);
	}

	/* Stats Panel */
	.stats-list {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.stat-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 4px 8px;
		background: var(--bg-2);
		border: 1px solid var(--border-0);
		border-radius: var(--radius-sm);
	}

	.stat-key {
		font-family: var(--font-heading);
		font-size: 10px;
		color: var(--text-2);
		letter-spacing: 0.05em;
	}

	.stat-val {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-0);
	}

	@media (max-width: 768px) {
		.sidebar {
			transform: translateX(-100%);
			width: 260px;
		}

		.sidebar.open {
			transform: translateX(0);
		}
	}
</style>

<script>
	// Quick select
	document.querySelectorAll("[data-select]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const action = (btn as HTMLElement).dataset.select;
			const checkboxes = document.querySelectorAll<HTMLInputElement>(
				'input[name="exchange"]',
			);

			checkboxes.forEach((cb) => {
				if (action === "all") {
					cb.checked = true;
				} else if (action === "none") {
					cb.checked = false;
				} else if (action === "tier1") {
					const item = cb.closest<HTMLElement>(".exchange-item");
					cb.checked = item?.dataset.tier === "1";
				}
			});
		});
	});

	// Toggle groups (interval & period)
	function setupToggleGroup(groupId: string) {
		const group = document.getElementById(groupId);
		if (!group) return;

		group.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				group.querySelectorAll(".toggle-btn").forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
			});
		});
	}

	setupToggleGroup("interval-group");
	setupToggleGroup("period-group");

	// Custom period toggle
	const customBtn = document.getElementById("custom-period-btn");
	const customInput = document.getElementById("custom-period-input");

	if (customBtn && customInput) {
		const periodGroup = document.getElementById("period-group");
		periodGroup?.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				if (btn.dataset.period === "custom") {
					customInput.classList.remove("hidden");
					(customInput as HTMLInputElement).focus();
				} else {
					customInput.classList.add("hidden");
				}
			});
		});
	}
</script>
