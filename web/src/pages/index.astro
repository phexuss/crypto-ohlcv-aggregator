---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import ChartArea from "../components/ChartArea.astro";
import DataTable from "../components/DataTable.astro";
---

<Layout title="Crypto OHLCV Aggregator — Dashboard">
	<Header />

	<main class="dashboard">
		<Sidebar />

		<div class="main-content">
			<ChartArea />
			<DataTable />
		</div>
	</main>

	<!-- Load app controller -->
	<script>
		import "../scripts/app.ts";
	</script>
</Layout>

<style>
	.dashboard {
		display: flex;
		min-height: 100vh;
		padding-top: var(--header-h);
		position: relative;
	}

	.main-content {
		flex: 1;
		margin-left: var(--sidebar-w);
		padding: var(--sp-4);
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	@media (max-width: 768px) {
		.main-content {
			margin-left: 0;
			padding: var(--sp-2);
		}
	}
</style>
